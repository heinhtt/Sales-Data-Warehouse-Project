/*
===============================================================================
DDL Script: Create Gold Layer Views
===============================================================================
Script Purpose:
This script is designed to create views for the Gold layer in the data warehouse. The Gold layer represents the final, business-ready dimension and fact tables structured in a Star Schema.

Each view is responsible for performing necessary transformations and combining data from the Silver layer to produce clean, enriched datasets that are optimized for analytics and reporting.

Usage:
These views can be directly queried by analysts, reporting tools, or downstream applications to access the final, refined data for business intelligence and decision-making.
===============================================================================
*/



-- =============================================================================
-- Create Dimension: gold.dim_customers
-- =============================================================================

CREATE OR REPLACE VIEW gold.dim_customers AS
SELECT
    customer_id,
    customer_zip_code_prefix,
    customer_city,
    customer_state,
    dwh_create_date AS create_date
FROM silver.customers;

-- =============================================================================
-- Create Dimension: gold.dim_orders
-- =============================================================================

CREATE OR REPLACE VIEW gold.dim_orders AS
SELECT
    order_id,
    order_status,
    order_purchase_timestamp,
    order_approved_at,
    order_delivered_customer_date,
    order_estimated_delivery_date,
    dwh_create_date AS create_date
FROM silver.orders;

-- =============================================================================
-- Create Dimension: gold.dim_payments
-- =============================================================================

CREATE OR REPLACE VIEW gold.dim_payments AS
SELECT
    order_id,
    payment_sequential,
    payment_type,
    payment_installments,
    payment_value,
    dwh_create_date AS create_date
FROM silver.order_payments;

-- =============================================================================
-- Create Dimension: gold.dim_products
-- =============================================================================

CREATE OR REPLACE VIEW gold.dim_products AS
SELECT
    p.product_id,
    p.product_category_name AS product_cat_name,
    pt.product_category_name_english AS product_cat_name_eng,
    p.product_weight_g,
    p.product_length_cm,
    p.product_height_cm,
    p.product_width_cm,
    p.dwh_create_date AS create_date
FROM silver.products AS p
LEFT JOIN silver.product_category_name_translation AS pt
    ON p.product_category_name = pt.product_category_name;

-- =============================================================================
-- Create Dimension: gold.dim_sellers
-- =============================================================================

CREATE OR REPLACE VIEW gold.dim_sellers AS
SELECT
    seller_id,
    seller_zip_code_prefix,
    seller_city,
    seller_state,
    dwh_create_date AS create_date
FROM silver.sellers;

-- =============================================================================
-- Create Fact Table: gold.fact_sales
-- =============================================================================

CREATE OR REPLACE VIEW gold.fact_sales AS
SELECT
    s.sale_id,
    s.order_id,
    s.product_id,
    o.customer_id,
    s.seller_id,
    s.price AS unit_price,
    s.freight_value AS unit_freight_value
FROM silver.order_items AS s
LEFT JOIN silver.orders AS o
    ON s.order_id = o.order_id;
